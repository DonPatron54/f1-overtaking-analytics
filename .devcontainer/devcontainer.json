{
  "name": "F1 Overtaking Analytics (Python 3.11 + PostgreSQL 16)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",

  "initializeCommand": "sh .devcontainer/init-env.sh",
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq postgresql-client && pip install --upgrade pip && pip install -r requirements.txt && python -m src.db init",
  "postStartCommand": "python -m src.db check",

  "forwardPorts": [5432],
  "portsAttributes": {
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },

  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker",
        "ms-ossdata.vscode-pgsql",
        "mechatroner.rainbow-csv"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.notebookFileRoot": "${workspaceFolder}",
        "editor.rulers": [88]
      }
    }
  }
}
