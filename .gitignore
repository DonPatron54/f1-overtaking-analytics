# Secrets
.env
.devcontainer/.env

# Data: the FastF1 HTTP cache is large and can be rebuilt from data/raw.
# Raw API responses ARE committed: collection takes hours (API rate limits)
# and the sources can change (e.g. F1 live-timing access since 2026).
data/cache/
reports/logs/*_run.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
*.swp
~$*
